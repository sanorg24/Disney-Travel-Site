---
permalink: "outfits.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shop Disney Outfits | The Pixie Packed Family</title>
<meta name="description" content="Character-inspired Disney park outfits, organized by theme, with shoppable Amazon links for every piece.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --purple: #7b5fe0; --magenta: #c23f97; --coral: #e76e8c; --orange: #eda268;
    --maroon: #5c2a38; --pink-bg: #fbe0ec; --gold: #e8c468; --cream: #fff8f3;
    --gray: #7a6f78; --ink: #3a2733; --white: #ffffff;
    --radius: 16px; --shadow: 0 6px 26px rgba(92,42,56,0.12); --shadow-lg: 0 16px 44px rgba(92,42,56,0.20);
  }
  * , *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'Quicksand', -apple-system, sans-serif; background: var(--cream); color: var(--ink); line-height: 1.6; }
  h1, h2, h3 { font-family: 'Fredoka', sans-serif; }
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; display: block; }
  .wrap { max-width: 1140px; margin: 0 auto; padding: 0 24px; }

  header { background: var(--maroon); position: sticky; top: 0; z-index: 50; }
  nav.wrap { display: flex; align-items: center; justify-content: space-between; height: 70px; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--white); font-size: 1.2rem; font-weight: 600; }
  .brand .mark { width: 36px; height: 36px; border-radius: 50%; background: var(--gold); display: flex; align-items: center; justify-content: center; font-size: 1.15rem; }
  .navlinks a { color: rgba(255,255,255,0.85); font-size: 0.88rem; font-weight: 600; padding: 8px 14px; border-radius: 8px; }
  .navlinks a:hover { background: rgba(255,255,255,0.12); color: var(--gold); }

  .pagehero { background: var(--pink-bg); padding: 56px 24px 44px; text-align: center; }
  .pagehero .eyebrow { text-transform: uppercase; letter-spacing: 2px; font-size: 0.75rem; color: var(--magenta); font-weight: 700; margin-bottom: 14px; }
  .pagehero h1 { font-size: clamp(1.9rem, 4.2vw, 2.7rem); margin-bottom: 12px; }
  .pagehero p { color: var(--gray); max-width: 520px; margin: 0 auto; }

  .category { padding: 50px 24px; }
  .category:nth-child(even) { background: var(--white); }
  .cat-title { font-size: 1.4rem; margin-bottom: 4px; }
  .cat-sub { color: var(--gray); font-size: 0.9rem; margin-bottom: 26px; }

  .outfit-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; }
  .outfit-card { background: var(--pink-bg); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); transition: transform .18s, box-shadow .18s; flex: 1 1 210px; max-width: 300px; }
  .outfit-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .outfit-card img { width: 100%; height: auto; } /* full photo, never cropped */
  .outfit-card-body { padding: 14px 16px 16px; }
  .outfit-card-body h3 { font-size: 0.88rem; margin-bottom: 10px; font-weight: 600; }
  .shop-links { display: flex; flex-direction: column; gap: 6px; }
  .shop-links a { font-size: 0.74rem; font-weight: 700; color: var(--magenta); padding: 5px 0; border-bottom: 1px solid rgba(194,63,151,0.15); }
  .shop-links a:hover { color: var(--coral); }

  .pixie-note { font-size: 0.74rem; color: var(--ink); font-style: italic; background: var(--white); border-radius: 8px; padding: 8px 10px; margin-bottom: 10px; border-left: 3px solid var(--gold); white-space: pre-line; }

  footer { background: #3a1a26; color: rgba(255,255,255,0.6); padding: 40px 24px 26px; text-align: center; font-family: 'Quicksand', sans-serif; }
  .footlinks { display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; margin: 16px 0; font-size: 0.85rem; }
  .footlinks a:hover { color: var(--gold); }
</style>
</head>
<body>

{% set backLinkHref = "shop.html" %}
{% set backLinkLabel = "← Back to Shop" %}
{% include "header.njk" %}

<section class="pagehero">
  <span class="eyebrow">Shop the Look</span>
  <h1>Shop Disney Outfits</h1>
  <p>Character-inspired outfits for every park event, each piece linked so you can shop the exact look.</p>
</section>

{%- set themeDefs = [
  { value: "park-day-outfits", label: "Park Day Outfits", sub: "Everyday outfit inspiration for a magical day at the parks." },
  { value: "disney-characters", label: "Disney Characters", sub: "Character-inspired looks and jewelry for your favorite Disney faces." },
  { value: "mnsshp", label: "Mickey's Not-So-Scary Halloween Party", sub: "Spooky-cute looks for MNSSHP nights at Magic Kingdom." }
] %}
{%- for theme in themeDefs %}
{%- set themeLooksList = collections.allLooks | byTheme(theme.value) %}
{%- if themeLooksList | length > 0 %}
<section class="category">
  <div class="wrap">
    <h2 class="cat-title">{{ theme.label }}</h2>
    <p class="cat-sub">{{ theme.sub }}</p>
    <div class="outfit-grid">
{%- for look in themeLooksList %}
      <div class="outfit-card">
        <img src="{{ look.collage_image }}" alt="{{ look.collage_image_alt }}">
        <div class="outfit-card-body">
          <h3>{{ look.title }}</h3>
{%- if look.pixie_note %}
          <p class="pixie-note">💡 {{ look.pixie_note }}</p>
{%- endif %}
          <div class="shop-links">
{%- for item in look.items %}
            <a href="{{ item.amazon_url }}" target="_blank" rel="noopener">{{ item.label }} →</a>
{%- endfor %}
          </div>
        </div>
      </div>
{%- endfor %}
    </div>
  </div>
</section>
{%- endif %}
{%- endfor %}

<footer>
  <div class="brand" style="justify-content:center; color:var(--white); margin-bottom:6px;">✦ The Pixie Packed Family</div>
  <div class="footlinks"><a href="index.html">Home</a><a href="index.html#mission">About</a><a href="outfits.html">Shop Disney Outfits</a><a href="apparel.html">Apparel</a><a href="accessories.html">Accessories</a><a href="holidays.html">Holidays &amp; Festivals</a><a href="sun-travel-essentials.html">Sun, Travel &amp; Personal Care</a></div>
  <p style="font-size:0.75rem; color:rgba(255,255,255,0.35); max-width:600px; margin:12px auto 0;">As an Amazon Associate, The Pixie Packed Family earns from qualifying purchases.</p>
</footer>

</body>
</html>
