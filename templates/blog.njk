---
permalink: "blog.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Blog | The Pixie Packed Family</title>
<meta name="description" content="Disney travel tips, Disney news, Amazon finds, outfit inspiration, and family & accessibility advice from The Pixie Packed Family.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --purple: #7b5fe0; --magenta: #c23f97; --coral: #e76e8c; --orange: #eda268;
    --maroon: #5c2a38; --pink-bg: #fbe0ec; --gold: #e8c468; --cream: #fff8f3;
    --gray: #7a6f78; --ink: #3a2733; --white: #ffffff;
    --radius: 16px; --shadow: 0 6px 26px rgba(92,42,56,0.12); --shadow-lg: 0 16px 44px rgba(92,42,56,0.20);
  }
  * , *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'Quicksand', -apple-system, sans-serif; background: var(--cream); color: var(--ink); line-height: 1.6; }
  h1, h2, h3 { font-family: 'Fredoka', sans-serif; }
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; display: block; }
  .wrap { max-width: 1140px; margin: 0 auto; padding: 0 24px; }

  header { background: var(--maroon); position: sticky; top: 0; z-index: 50; }
  nav.wrap { display: flex; align-items: center; justify-content: space-between; height: 70px; flex-wrap: wrap; gap: 8px; padding-top: 10px; padding-bottom: 10px; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--white); font-size: 1.2rem; font-weight: 600; }
  .brand .mark { width: 36px; height: 36px; border-radius: 50%; background: var(--gold); display: flex; align-items: center; justify-content: center; font-size: 1.15rem; flex-shrink: 0; }
  .navlinks a { color: rgba(255,255,255,0.85); font-size: 0.88rem; font-weight: 600; padding: 8px 14px; border-radius: 8px; }
  .navlinks a:hover { background: rgba(255,255,255,0.12); color: var(--gold); }

  .pagehero { background: var(--pink-bg); padding: 48px 20px 36px; text-align: center; }
  .pagehero .eyebrow { text-transform: uppercase; letter-spacing: 2px; font-size: 0.72rem; color: var(--magenta); font-weight: 700; margin-bottom: 14px; }
  .pagehero h1 { font-size: clamp(1.7rem, 6vw, 2.6rem); margin-bottom: 12px; }
  .pagehero p { color: var(--gray); max-width: 560px; margin: 0 auto; font-size: 0.95rem; }

  .filterbar { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; padding: 24px 16px 0; }
  .filter-btn { background: var(--white); box-shadow: var(--shadow); padding: 9px 16px; border-radius: 50px; font-size: 0.82rem; font-weight: 700; color: var(--maroon); border: 2px solid transparent; cursor: pointer; font-family: 'Quicksand', sans-serif; }
  .filter-btn:hover { background: var(--pink-bg); }
  .filter-btn.active { background: var(--magenta); color: var(--white); }

  .blog-section { padding: 40px 16px 60px; }
  .blog-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 22px; }
  .blog-card { background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; display: flex; flex-direction: column; transition: transform .18s, box-shadow .18s; flex: 1 1 260px; max-width: 340px; }
  .blog-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .blog-card-img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: center 25%; display: block; }
  .blog-card-top { background: linear-gradient(135deg, var(--purple), var(--magenta)); padding: 22px 22px 18px; }
  .blog-tag { display: inline-block; background: rgba(255,255,255,0.22); color: var(--white); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; padding: 5px 10px; border-radius: 20px; margin-bottom: 10px; }
  .blog-card-top h3 { color: var(--white); font-size: 1.1rem; }
  .blog-card-body { padding: 18px 22px 22px; flex: 1; display: flex; flex-direction: column; }
  .blog-card-body .blog-date { font-size: 0.75rem; color: var(--gray); margin-bottom: 8px; }
  .blog-card-body p { font-size: 0.88rem; color: var(--gray); flex: 1; margin-bottom: 16px; }
  .blog-card-body .read-more { font-size: 0.82rem; font-weight: 700; color: var(--magenta); align-self: flex-start; }
  .blog-card-body .read-more:hover { color: var(--coral); }

  .empty-state { text-align: center; color: var(--gray); font-style: italic; padding: 40px; display: none; }

  footer { background: #3a1a26; color: rgba(255,255,255,0.6); padding: 40px 20px 26px; text-align: center; font-family: 'Quicksand', sans-serif; }
  .footlinks { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; margin: 16px 0; font-size: 0.85rem; }
  .footlinks a:hover { color: var(--gold); }

  @media (max-width: 640px) {
    nav.wrap { justify-content: center; text-align: center; height: auto; }
    .pagehero { padding: 40px 16px 30px; }
    .blog-card { flex: 1 1 100%; max-width: 420px; }
  }
</style>
</head>
<body>

{% include "header.njk" %}

<section class="pagehero">
  <span class="eyebrow">The Pixie Packed Family Blog</span>
  <h1>Tips, Reviews &amp; Finds</h1>
  <p>Real-life Disney tips from our family to yours. From vacation planning and packing to Disney updates, outfit inspiration, and accessibility—we share what we've learned along the way to help make your family's Disney vacation a little easier and a lot more magical.</p>
</section>

<div class="filterbar" id="filterbar">
  <button class="filter-btn active" data-tag="all">All Posts</button>
  <button class="filter-btn" data-tag="travel-tips">Travel Tips</button>
  <button class="filter-btn" data-tag="disney-news">Disney News &amp; Updates</button>
  <button class="filter-btn" data-tag="outfit-inspiration">Outfits &amp; Packing</button>
  <button class="filter-btn" data-tag="family-accessibility">Family &amp; Accessibility</button>
</div>

<section class="blog-section">
  <div class="wrap">
    <div class="blog-grid" id="blog-grid">
      {%- for post in collections.blogPosts %}
      <a class="blog-card" data-tag="{{ post.data.tag }}" href="{{ post.url | stripLeadingSlash }}">
        {%- if post.data.hero_image %}
        <img class="blog-card-img" src="{{ post.data.hero_image }}" alt="{{ post.data.hero_alt }}">
        {%- endif %}
        <div class="blog-card-top">
          <span class="blog-tag">{{ post.data.tag | tagLabel }}</span>
          <h3>{{ post.data.title }}</h3>
        </div>
        <div class="blog-card-body">
          <span class="blog-date">{{ post.data.date | isoDate }}</span>
          <p>{{ post.data.excerpt }}</p>
          <span class="read-more">Read More →</span>
        </div>
      </a>
      {%- endfor %}
    </div>
    <p class="empty-state" id="empty-state">No posts in this category yet — check back soon!</p>
  </div>
</section>

<footer>
  <div class="brand" style="justify-content:center; color:var(--white); margin-bottom:6px;">✦ The Pixie Packed Family</div>
  <div class="footlinks"><a href="index.html">Home</a><a href="index.html#mission">About</a><a href="outfits.html">Shop Disney Outfits</a><a href="apparel.html">Apparel</a><a href="accessories.html">Accessories</a><a href="holidays.html">Holidays &amp; Festivals</a><a href="sun-travel-essentials.html">Sun, Travel &amp; Personal Care</a></div>
  <p style="font-size:0.75rem; color:rgba(255,255,255,0.35); max-width:600px; margin:12px auto 0;">As an Amazon Associate, The Pixie Packed Family earns from qualifying purchases.</p>
</footer>

<script>
  var buttons = document.querySelectorAll('.filter-btn');
  var cards = document.querySelectorAll('.blog-card');
  var emptyState = document.getElementById('empty-state');

  function applyFilter(tag) {
    var visibleCount = 0;
    cards.forEach(function (card) {
      var match = (tag === 'all' || card.getAttribute('data-tag') === tag);
      card.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });
    emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
    buttons.forEach(function (btn) {
      btn.classList.toggle('active', btn.getAttribute('data-tag') === tag);
    });
  }

  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      applyFilter(btn.getAttribute('data-tag'));
      history.replaceState(null, '', '#tag=' + btn.getAttribute('data-tag'));
    });
  });

  // Pre-filter based on a #tag=... link (e.g. from the homepage "What You'll Find" list)
  var hashMatch = location.hash.match(/tag=([\w-]+)/);
  if (hashMatch && document.querySelector('.filter-btn[data-tag="' + hashMatch[1] + '"]')) {
    applyFilter(hashMatch[1]);
  }
</script>

</body>
</html>
