<!DOCTYPE html>
<html lang="en">
<head>
{% include "analytics.njk" %}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{%- set pageTitle = "The Pixie Packed Family | Disney Tips, Outfits & Planning Guides" %}
{%- set pageDescription = "Real-family Disney park tips, outfit inspiration, helpful planning guides, and tried-and-loved favorites to make Disney days easier and more magical. ✨" %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
{%- set ogTitle = pageTitle %}
{%- set ogDescription = pageDescription %}
{%- set ogImage = "/photos/family-castle.jpg" %}
{% include "seo-meta.njk" %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --purple: #7b5fe0;
    --magenta: #c23f97;
    --coral: #e76e8c;
    --orange: #eda268;
    --maroon: #5c2a38;
    --pink-bg: #fbe0ec;
    --gold: #e8c468;
    --cream: #fff8f3;
    --gray: #7a6f78;
    --ink: #3a2733;
    --white: #ffffff;
    --radius: 18px;
    --shadow: 0 6px 26px rgba(92,42,56,0.12);
    --shadow-lg: 0 16px 44px rgba(92,42,56,0.20);
  }
  * , *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Quicksand', -apple-system, sans-serif;
    background: var(--cream);
    color: var(--ink);
    line-height: 1.65;
  }
  h1, h2, h3, .display { font-family: 'Fredoka', sans-serif; }
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; display: block; }
  .wrap { max-width: 1140px; margin: 0 auto; padding: 0 24px; }
  a[data-placeholder="true"] { outline: 2px dashed var(--magenta); outline-offset: 3px; }

  .gradient-text {
    background: linear-gradient(90deg, var(--purple), var(--magenta) 40%, var(--coral) 70%, var(--orange));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  header { background: var(--maroon); position: sticky; top: 0; z-index: 50; }
  nav.wrap { display: flex; align-items: center; justify-content: space-between; height: 70px; flex-wrap: wrap; gap: 8px; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--white); font-size: 1.2rem; font-weight: 600; }
  .brand .mark { width: 36px; height: 36px; border-radius: 50%; background: var(--gold); display: flex; align-items: center; justify-content: center; font-size: 1.15rem; }
  .navlinks { display: flex; gap: 4px; }
  .navlinks a { color: rgba(255,255,255,0.85); font-size: 0.88rem; font-weight: 600; padding: 8px 14px; border-radius: 8px; }
  .navlinks a:hover { background: rgba(255,255,255,0.12); color: var(--gold); }

  .hamburger-btn { display: none; background: none; border: none; color: var(--white); font-size: 1.6rem; cursor: pointer; padding: 6px 8px; line-height: 1; }
  .mobile-menu { display: none; flex-direction: column; background: var(--maroon); border-top: 1px solid rgba(255,255,255,0.12); }
  .mobile-menu a { color: rgba(255,255,255,0.9); font-size: 0.95rem; font-weight: 600; padding: 14px 24px; border-bottom: 1px solid rgba(255,255,255,0.08); }
  .mobile-menu a:hover { background: rgba(255,255,255,0.08); color: var(--gold); }
  .mobile-menu.open { display: flex; }

  .hero { background: linear-gradient(160deg, var(--pink-bg) 0%, #fdeef4 60%, var(--cream) 100%); padding: 70px 24px 40px; }
  .hero-inner { max-width: 1140px; margin: 0 auto; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 50px; align-items: center; }
  .hero-text .eyebrow { text-transform: uppercase; letter-spacing: 2px; font-size: 0.75rem; color: var(--magenta); font-weight: 700; margin-bottom: 16px; }
  .hero-text h1 { font-size: clamp(2rem, 4.4vw, 3.1rem); font-weight: 700; line-height: 1.16; margin-bottom: 16px; }
  .hero-text p.sub { color: var(--gray); font-size: 1rem; max-width: 480px; margin-bottom: 30px; }
  .btnrow { display: flex; gap: 14px; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; gap: 8px; padding: 14px 26px; border-radius: 12px; font-weight: 700; font-size: 0.95rem; border: 2px solid transparent; transition: transform .15s; }
  .btn:hover { transform: translateY(-2px); }
  .btn-gold { background: var(--gold); color: var(--maroon); }
  .btn-outline { border-color: var(--maroon); color: var(--maroon); }
  .hero-photo { border-radius: 22px; overflow: hidden; box-shadow: var(--shadow-lg); border: 6px solid var(--white); transform: rotate(1.5deg); }
  .hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; }

  section { padding: 64px 24px; }
  .label { text-transform: uppercase; letter-spacing: 1.5px; font-size: 0.72rem; font-weight: 700; color: var(--magenta); margin-bottom: 10px; display: block; }
  .stitle { font-size: clamp(1.6rem, 3.2vw, 2.15rem); font-weight: 600; margin-bottom: 14px; }
  .ssub { color: var(--gray); max-width: 620px; margin-bottom: 38px; font-size: 1rem; }

  /* PRODUCTS */
  .products { background: var(--white); }
  .grid4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 22px; }
  .tag-card { background: var(--pink-bg); border-radius: var(--radius); padding: 28px 24px; display: flex; flex-direction: column; transition: transform .18s, box-shadow .18s; }
  .tag-card:hover { transform: translateY(-5px); box-shadow: var(--shadow); }
  .cat-photo { width: 56px; height: 56px; border-radius: 12px; object-fit: contain; margin-bottom: 12px; box-shadow: var(--shadow); }
  .tag-card h3 { font-size: 1.02rem; margin-bottom: 8px; font-weight: 600; }
  .tag-card p { font-size: 0.86rem; color: var(--gray); flex: 1; margin-bottom: 18px; }
  .btn-sm { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 16px; border-radius: 9px; font-weight: 700; font-size: 0.82rem; background: #ff9900; color: var(--white); }
  .section-cta { margin-top: 34px; text-align: center; }
  .btn-outline-sm { display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; border-radius: 10px; font-weight: 700; font-size: 0.9rem; border: 2px solid var(--maroon); color: var(--maroon); }

  /* OUTFIT INSPIRATION */
  .looks { background: var(--cream); }
  .grid-looks { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
  .look-card { border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); background: var(--white); }
  .look-card img { width: 100%; height: 220px; object-fit: contain; }
  .look-card .look-title { padding: 12px 14px; font-size: 0.88rem; font-weight: 700; color: var(--maroon); }

  /* GUIDES */
  .guides { background: var(--white); }
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
  .guide-card { border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); background: var(--pink-bg); max-width: 420px; transition: transform .18s, box-shadow .18s; }
  .guide-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .guide-card-link { display: block; }
  .guide-card-graphic { width: 100%; height: auto; display: block; }
  .guide-card-cta { padding: 16px 20px 20px; text-align: center; background: var(--white); }

  .kit-form-fullwidth { margin-top: 32px; max-width: 100%; overflow-x: hidden; background: var(--pink-bg); border-radius: var(--radius); padding: 28px 24px; box-shadow: var(--shadow); }

  @media (max-width: 640px) {
    .guides .grid2 { grid-template-columns: 1fr; }
    .guides .guide-card { max-width: 420px; margin: 0 auto; }
    .kit-form-fullwidth { padding: 20px 16px; margin-top: 24px; }
  }

  /* BLOG TEASER */
  .blogteaser { background: var(--cream); padding-top: 34px; padding-bottom: 34px; }

  /* OUR STORY (shortened) */
  .story { background: var(--pink-bg); }
  .story-block { display: grid; grid-template-columns: 1fr 1.3fr; gap: 40px; align-items: center; }
  .story-photo { border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
  .story-photo img { width: 100%; height: 320px; object-fit: cover; object-position: center 20%; }
  .story-text p { color: var(--maroon); margin-bottom: 14px; font-size: 0.97rem; line-height: 1.75; }
  .signature { font-family: 'Fredoka', sans-serif; font-size: 1.2rem; color: var(--magenta); margin-top: 6px; margin-bottom: 18px; }

  .star-accent { position: absolute; }

  /* SOCIAL */
  .social { background: #3a1a26; color: var(--white); }
  .social .ssub { color: rgba(255,255,255,0.65); }
  .grid4social { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
  .social-card { background: rgba(255,255,255,0.06); border-radius: var(--radius); padding: 24px; text-align: center; }
  .social-card .picon { font-size: 1.9rem; margin-bottom: 10px; }
  .social-card h3 { font-size: 1rem; margin-bottom: 4px; }
  .social-card p { font-size: 0.82rem; color: rgba(255,255,255,0.6); margin-bottom: 14px; }

  footer { background: #2c1420; color: rgba(255,255,255,0.6); padding: 40px 24px 30px; text-align: center; }
  .footlinks { display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; margin: 16px 0; font-size: 0.85rem; }
  .footlinks a:hover { color: var(--gold); }
  .fineprint { font-size: 0.78rem; color: rgba(255,255,255,0.4); max-width: 640px; margin: 0 auto; }

  @media (max-width: 800px) {
    .navlinks { display: none; }
    .hamburger-btn { display: block; }
    .hero-inner { grid-template-columns: 1fr; }
    .hero-photo { transform: none; }
    .story-block { grid-template-columns: 1fr; }
    .story-photo img { height: 240px; }
  }
</style>
</head>
<body>

{% set fullNav = true %}
{% include "header.njk" %}

<section class="hero sparkle-bg" style="overflow:hidden;">
  <span class="star-accent" style="top:14%; right:12%; font-size:1.6rem;">✦</span>
  <span class="star-accent" style="top:60%; left:6%; font-size:1.1rem;">✧</span>
  <span class="star-accent" style="bottom:10%; right:28%; font-size:0.9rem;">⋆</span>
  <div class="hero-inner">
    <div class="hero-text">
      <span class="eyebrow">REAL FAMILY • REAL DISNEY DAYS • REAL FAVORITES</span>
      <h1><span class="gradient-text">Helping Families Pack Less Stress &amp; More Pixie Dust ✨</span></h1>
      <p class="sub">From our Disney-loving family to yours — honest park tips, outfit inspiration, helpful guides, and the things we actually use to make Disney days a little easier and a lot more magical.</p>
      <div class="btnrow">
        <a class="btn btn-gold" href="shop.html">Explore Our Disney Finds</a>
        <a class="btn btn-outline" href="guides/ultimate-park-day-packing-checklist.pdf">Get the Free Park Day Checklist</a>
      </div>
    </div>
    <div class="hero-photo"><img src="photos/family-castle.jpg" alt="The Pixie Packed Family at Magic Kingdom"></div>
  </div>
</section>

<section class="products" id="picks">
  <div class="wrap">
    <span class="label">Shop the Parks</span>
    <h2 class="stitle">Our Disney Favorites</h2>
    <p class="ssub">Real gear I actually use and recommend for park days — as an Amazon Associate I earn from qualifying purchases.</p>
    <div class="grid4">
      <div class="tag-card"><img class="cat-photo" src="photos/apparel-family-01.jpg" alt="Apparel"><h3>Apparel</h3><p>Matching family tees plus Disney apparel for men, women, and kids.</p><a class="btn-sm" href="apparel.html" style="background:var(--purple)">Shop Apparel →</a></div>
      <div class="tag-card"><img class="cat-photo" src="photos/accessories-loungefly-01.jpg" alt="Park Day Accessories"><h3>Park Day Accessories</h3><p>Hats, ears, headbands, and backpacks for a comfortable, magical day.</p><a class="btn-sm" href="accessories.html" style="background:var(--purple)">Shop Accessories →</a></div>
      <div class="tag-card"><img class="cat-photo" src="photos/sun-travel-01.jpg" alt="Sun, Travel & Personal Care"><h3>Sun, Travel &amp; Personal Care</h3><p>Sunscreen, hair care, cooling gear, and travel-friendly personal care picks for hot park days.</p><a class="btn-sm" href="sun-travel-essentials.html" style="background:var(--orange)">Shop Essentials →</a></div>
      <div class="tag-card"><img class="cat-photo" src="photos/outfit-mnsshp.jpg" alt="Shop Disney Collections"><h3>Shop Disney Collections</h3><p>Curated Disney outfits, travel-day favorites, park-bag essentials &amp; more — all put together to make planning and packing a little easier.</p><a class="btn-sm" href="outfits.html" style="background:var(--magenta)">Shop Disney Collections →</a></div>
      <div class="tag-card"><img class="cat-photo" src="photos/holiday-mnsshp-01.jpg" alt="Holidays & Festivals"><h3>Holidays &amp; Festivals</h3><p>Seasonal Disney apparel, starting with Family Halloween and MNSSHP picks.</p><a class="btn-sm" href="holidays.html" style="background:var(--coral)">Shop Holidays →</a></div>
    </div>
    <div class="section-cta">
      <a class="btn-outline-sm" href="shop.html">Shop All Disney Finds →</a>
    </div>
  </div>
</section>

{%- set teaserLooks = collections.allLooks %}
{%- if teaserLooks | length > 0 %}
<section class="looks">
  <div class="wrap">
    <span class="label">Get Inspired</span>
    <h2 class="stitle">Disney Collections &amp; Inspiration</h2>
    <p class="ssub">From park-day outfits to travel favorites and park-bag essentials, shop our curated collections to make planning your next Disney adventure a little easier.</p>
    <div class="grid-looks">
      {%- for look in teaserLooks %}
      {%- if loop.index0 < 4 %}
      <a class="look-card" href="outfits.html">
        <img src="{{ look.collage_image }}" alt="{{ look.collage_image_alt }}">
        <div class="look-title">{{ look.title }}</div>
      </a>
      {%- endif %}
      {%- endfor %}
    </div>
    <div class="section-cta">
      <a class="btn-outline-sm" href="outfits.html">See All Collections →</a>
    </div>
  </div>
</section>
{%- endif %}

<section class="guides" id="guides">
  <div class="wrap">
    <span class="label">Plan Ahead</span>
    <h2 class="stitle">Downloadable Trip Guides</h2>
    <p class="ssub">Printable, practical guides created to make Disney vacation planning a little easier—and a lot more magical. ✨</p>
    <div class="grid2">
      <a class="guide-card guide-card-link" href="guides/ultimate-park-day-packing-checklist.pdf">
        <img class="guide-card-graphic" src="photos/promo-park-day-checklist.png" alt="Ultimate Park Day Packing Checklist — free printable 1-page PDF, get your free checklist">
      </a>
      <a class="guide-card guide-card-link" href="#kit-signup">
        <img class="guide-card-graphic" src="photos/promo-ultimate-packing-list.png" alt="The Ultimate Disney Packing List — free with email signup, sign up below">
      </a>
      <div class="guide-card">
        <a class="guide-card-link" href="https://disneylife0.gumroad.com/l/wqgoxx" target="_blank" rel="noopener">
          <img class="guide-card-graphic" src="photos/promo-vacation-planner.png" alt="Disney Vacation Planner — 13-page printable planner, $4 digital download">
        </a>
        <div class="guide-card-cta"><a class="btn-sm" href="https://disneylife0.gumroad.com/l/wqgoxx" target="_blank" rel="noopener" style="background:var(--purple)">Get the Planner →</a></div>
      </div>
    </div>
    <div class="kit-form-fullwidth" id="kit-signup">
      <script async data-uid="97edddd727" src="https://the-pixie-packed-family.kit.com/97edddd727/index.js"></script>
    </div>
  </div>
</section>

<section class="blogteaser">
  <div class="wrap">
    <span class="label">Helpful Reading</span>
    <h2 class="stitle">From the Blog</h2>
    <p class="ssub">Real trip planning, honest tips, and the Amazon finds that actually made a difference on our own Disney vacations.</p>
    <div class="section-cta" style="margin-top:0;">
      <a class="btn-outline-sm" href="blog.html">Read the Blog →</a>
    </div>
  </div>
</section>

<section class="story" id="mission">
  <div class="wrap">
    <span class="label">Hi, We're The Pixie Packed Family</span>
    <h2 class="stitle">Welcome! We're so glad you're here.</h2>
    <div class="story-block">
      <div class="story-photo"><img src="photos/family-photo-4.jpg" alt="The Pixie Packed Family"></div>
      <div class="story-text">
        <p>I'm Vanessa — a wife, mom of four, grandma, and full-time caregiver to our son Seth. In 2021 I stepped away from teaching to care for him full-time, and our family sold nearly everything to travel the country in a fifth-wheel camper. Then in March 2023, our first Disney vacation together changed everything — watching Seth's joy reminded us why we do this. We were hooked, and in 2025 we moved to Kissimmee, Florida, when my husband Troy joined the Disney team.</p>
        <p>The Pixie Packed Family is everything we've learned along the way: honest planning tips, real gear we use, and a little pixie magic — so your family can spend less time stressing over details and more time making memories.</p>
        <p class="signature">See you in the parks! — Vanessa</p>
        <a class="btn-outline-sm" href="our-story.html">Read Our Story →</a>
      </div>
    </div>
  </div>
</section>

<section class="social" id="follow">
  <div class="wrap">
    <span class="label">Come Say Hi</span>
    <h2 class="stitle">Follow Along</h2>
    <p class="ssub" style="color:rgba(255,255,255,0.65)">Daily tips, packing hacks, and real park-day moments.</p>
    <div class="grid4social">
      <div class="social-card"><div class="picon">🎵</div><h3>TikTok</h3><p>@thepixiepackedfamily</p><a class="btn-sm" href="https://www.tiktok.com/@thepixiepackedfamily" style="background:#000" target="_blank" rel="noopener">Follow →</a></div>
      <div class="social-card"><div class="picon">▶️</div><h3>YouTube</h3><p>@thepixiepackedfamily</p><a class="btn-sm" href="https://youtube.com/@thepixiepackedfamily" style="background:#ff0000" target="_blank" rel="noopener">Subscribe →</a></div>
      <div class="social-card"><div class="picon">📘</div><h3>Facebook</h3><p>The Pixie Packed Family</p><a class="btn-sm" href="https://www.facebook.com/share/1FXpKAP92W/" style="background:#1877f2" target="_blank" rel="noopener">Follow →</a></div>
      <div class="social-card"><div class="picon">📸</div><h3>Instagram</h3><p>@vanessagronas</p><a class="btn-sm" href="https://www.instagram.com/vanessagronas" style="background:#c1387e" target="_blank" rel="noopener">Follow →</a></div>
    </div>
  </div>
</section>

<footer>
  <div class="brand" style="justify-content:center; color:var(--white); margin-bottom:6px;">✦ The Pixie Packed Family</div>
  <p style="font-size:0.85rem; color:rgba(255,255,255,0.4)">Disney vacation planning &amp; travel essentials</p>
  <div class="footlinks">
    <a href="index.html">Home</a>
    <a href="shop.html">Shop</a>
    <a href="our-story.html">Our Story</a>
    <a href="blog.html">Blog</a>
    <a href="guides/ultimate-park-day-packing-checklist.pdf">Free Checklist</a>
  </div>
  <p class="fineprint">As an Amazon Associate I earn from qualifying purchases. This site is not affiliated with, endorsed by, or sponsored by The Walt Disney Company.</p>
</footer>

<script>
  var hamburgerBtn = document.getElementById('hamburger-btn');
  var mobileMenu = document.getElementById('mobile-menu');
  hamburgerBtn.addEventListener('click', function () {
    var isOpen = mobileMenu.classList.toggle('open');
    hamburgerBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    hamburgerBtn.textContent = isOpen ? '✕' : '☰';
  });
  mobileMenu.querySelectorAll('a').forEach(function (link) {
    link.addEventListener('click', function () {
      mobileMenu.classList.remove('open');
      hamburgerBtn.setAttribute('aria-expanded', 'false');
      hamburgerBtn.textContent = '☰';
    });
  });
</script>

</body>
</html>
