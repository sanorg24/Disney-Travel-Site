.tppf-programs__link { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 46px; padding: 11px 16px; border: 2px solid #e9b82f; border-radius: 10px; background: #e9b82f; color: #17314d; text-decoration: none; text-align: center; font-size: .86rem; font-weight: 800; line-height: 1.35; box-shadow: 0 4px 0 rgba(0,0,0,.13); transition: background .15s ease, transform .15s ease; }
