<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} | The Pixie Packed Family</title>
<meta name="description" content="{{ meta_description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --purple: #7b5fe0; --magenta: #c23f97; --coral: #e76e8c; --orange: #eda268;
    --maroon: #5c2a38; --pink-bg: #fbe0ec; --gold: #e8c468; --cream: #fff8f3;
    --gray: #7a6f78; --ink: #3a2733; --white: #ffffff;
    --radius: 16px; --shadow: 0 6px 26px rgba(92,42,56,0.12); --shadow-lg: 0 16px 44px rgba(92,42,56,0.20);
  }
  * , *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'Quicksand', -apple-system, sans-serif; background: var(--cream); color: var(--ink); line-height: 1.7; }
  h1, h2, h3 { font-family: 'Fredoka', sans-serif; }
  a { color: var(--magenta); text-decoration: none; }
  a:hover { color: var(--coral); }
  img { max-width: 100%; display: block; }
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 24px; }

  header { background: var(--maroon); position: sticky; top: 0; z-index: 50; }
  nav.wrap { max-width: 1140px; display: flex; align-items: center; justify-content: space-between; height: 70px; flex-wrap: wrap; gap: 8px; padding-top: 10px; padding-bottom: 10px; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--white); font-size: 1.2rem; font-weight: 600; text-decoration: none; }
  .brand .mark { width: 36px; height: 36px; border-radius: 50%; background: var(--gold); display: flex; align-items: center; justify-content: center; font-size: 1.15rem; flex-shrink: 0; }
  .navlinks a { color: rgba(255,255,255,0.85); font-size: 0.85rem; font-weight: 600; padding: 8px 12px; border-radius: 8px; }
  .navlinks a:hover { background: rgba(255,255,255,0.12); color: var(--gold); }

  .articlehero { background: var(--pink-bg); padding: 44px 20px 36px; text-align: center; }
  .articlehero .blog-tag { display: inline-block; background: var(--magenta); color: var(--white); font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; padding: 5px 12px; border-radius: 20px; margin-bottom: 14px; }
  .articlehero h1 { font-size: clamp(1.6rem, 5.5vw, 2.3rem); margin-bottom: 10px; }
  .articlehero .meta { color: var(--gray); font-size: 0.85rem; }

  .article-hero-img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 520px;
    margin: 32px auto;
    border-radius: 0;
  }

  article { padding: 40px 20px 60px; }
  article p { margin-bottom: 22px; font-size: 1rem; color: var(--ink); line-height: 1.75; }
  article h2 { font-size: 1.4rem; font-weight: 700; color: var(--maroon); margin: 46px 0 16px; padding-bottom: 8px; border-bottom: 2px solid var(--pink-bg); }
  article h2:first-child { margin-top: 0; }
  article h3 { font-size: 1.1rem; font-weight: 700; color: var(--magenta); margin: 32px 0 12px; }
  article ul, article ol { margin: 0 0 22px 1.2em; }
  article li { margin-bottom: 8px; line-height: 1.75; }
  article img {
    max-width: 100%;
    max-height: 560px;
    width: auto;
    height: auto;
    display: block;
    margin: 32px auto;
    border-radius: var(--radius);
  }

  .back-link { display: inline-block; margin: 30px 0 0; font-weight: 700; font-size: 0.9rem; }

  footer { background: #3a1a26; color: rgba(255,255,255,0.6); padding: 40px 20px 26px; text-align: center; font-family: 'Quicksand', sans-serif; }
  .footlinks { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; margin: 16px 0; font-size: 0.85rem; }
  .footlinks a { color: rgba(255,255,255,0.6); }
  .footlinks a:hover { color: var(--gold); }

  @media (max-width: 640px) {
    nav.wrap { justify-content: center; text-align: center; height: auto; }
    .articlehero { padding: 36px 16px 28px; }
    article { padding: 30px 16px 50px; }
    article p { font-size: 1.02rem; line-height: 1.8; }
    article h2 { font-size: 1.22rem; margin: 38px 0 14px; }
    article h3 { font-size: 1.05rem; margin: 26px 0 10px; }
  }
</style>
</head>
<body>

{% set backLinkHref = "blog.html" %}
{% set backLinkLabel = "← Back to Blog" %}
{% set brandHref = "index.html" %}
{% include "header.njk" %}

<section class="articlehero">
  <span class="blog-tag">{{ tag | tagLabel }}</span>
  <h1>{{ title }}</h1>
  <div class="meta">{{ date | isoDate }}</div>
</section>

{% if hero_image %}
<img class="article-hero-img" src="{{ hero_image }}" alt="{{ hero_alt }}">
{% endif %}

<article class="wrap">
  {{ content | safe }}
  <a class="back-link" href="blog.html">← Back to all posts</a>
</article>

<footer>
  <div class="brand" style="justify-content:center; color:var(--white); margin-bottom:6px;">✦ The Pixie Packed Family</div>
  <div class="footlinks"><a href="index.html">Home</a><a href="index.html#mission">About</a><a href="blog.html">Blog</a><a href="apparel.html">Apparel</a><a href="accessories.html">Accessories</a><a href="holidays.html">Holidays &amp; Festivals</a><a href="sun-travel-essentials.html">Sun, Travel &amp; Personal Care</a></div>
  <p style="font-size:0.75rem; color:rgba(255,255,255,0.35); max-width:600px; margin:12px auto 0;">As an Amazon Associate I earn from qualifying purchases.</p>
</footer>

</body>
</html>
